# Place this file at: .github/workflows/update-data.yml
#
# Runs the scraper every 30 minutes on weekdays during PSX trading hours
# (roughly 9:00-16:00 PKT = 04:00-11:00 UTC), and commits data.json if it
# changed. Also runnable manually from the Actions tab.
name: Update PSX data

on:
  schedule:
    - cron: "*/30 4-11 * * 1-5"
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  update-data:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run scraper
        run: python scripts/fetch_psx_data.py

      - name: Commit data.json if it changed
        run: |
          git config user.name "psx-data-bot"
          git config user.email "actions@users.noreply.github.com"
          if ! git diff --quiet -- data.json; then
            git add data.json
            git commit -m "Update PSX data $(date -u +'%Y-%m-%d %H:%M UTC')"
            git push
          else
            echo "No changes to data.json"
          fi
